    {% set absolutePostUrl = site.url ~ page.url %}
    <share-actions 
        data-title="{{ title }}" 
        data-text="{{ description }}"
        data-url="{{ absolutePostUrl }}" class="stack elevated">
        
        <div data-fallback class="stack">
        <h2>Podziel się dalej</h2>
        
        <div class="cluster input-group">
            <input type="text" readonly value="{{ absolutePostUrl }}" aria-label="Link do artykułu" class="share-input" data-copy-target>
            <button type="button" button-variant="secondary" class="button" data-copy-trigger data-pending aria-label="Skopiuj link do schowka">Kopiuj</button>
            <button type="button" class="button" data-share-button data-pending>Udostępnij</button>
        </div>
        </div>
        
      <p role="status" data-share-status></p>
    </share-actions>
