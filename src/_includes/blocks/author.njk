<footer class="author-bio elevated">
    <span class="author-photo">
      <img src="{{ author.photo }}" alt="{{ author.name }}" width="128" height="128" loading="lazy" draggable="false">
    </span>
    <div class="stack">
      <h2>{{ author.name }}</h2>
      <span>{{ author.bio }}</span>
    </div>
</footer>