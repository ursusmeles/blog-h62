<!DOCTYPE html>
<html lang="pl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <link rel="canonical" href="{{ site.url }}{{ page.url }}">
  <title>{{ title or 'Blog o RPG'}} | Heliocantharus RPG</title>
  <meta name="description" content="{{ description or 'Blog o grach fabularnych — artykuły, materiały do sandboxa i gry niezależne. Pisany w 100% przez człowieka.' }}">

  {% set socialImage = og_image or image or '/og-default.png' %}
  {% set isPost = tags and ('posts' in tags) %}

  <meta property="og:type" content="{{ 'article' if isPost else 'website' }}">
  <meta property="og:url" content="{{ site.url }}{{ page.url }}">
  <meta property="og:title" content="{{ title or 'Blog o RPG'}} | Heliocantharus RPG">
  <meta property="og:description" content="{{ description or 'Blog o grach fabularnych — artykuły, materiały do sandboxa i gry niezależne. Pisany w 100% przez człowieka.' }}">
  <meta property="og:image" content="{{ site.url }}{{ socialImage }}">
  
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ title or 'Blog o RPG'}} | Heliocantharus RPG">
  <meta name="twitter:description" content="{{ description or 'Blog o grach fabularnych — artykuły, materiały do sandboxa i gry niezależne. Pisany w 100% przez człowieka.' }}">
  <meta name="twitter:image" content="{{ site.url }}{{ socialImage }}">

  <link rel="preload" href="/fonts/abcsolar.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="/fonts/ibm-regular.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="/assets/main.css">
  <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="shortcut icon" href="/favicon.ico" />
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
  <meta name="apple-mobile-web-app-title" content="Helio62" />
  <link rel="manifest" href="/site.webmanifest" />
  <script>
  let theme = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
  try {
    const saved = localStorage.getItem('helio-theme-pref');
    if (saved === 'light' || saved === 'dark') theme = saved;
  } catch {}
  document.documentElement.dataset.theme = theme;
</script>
</head>
<body>
<a href="#main-content" class="skip-link">Przejdź do treści</a>

{% include "header.njk" %}

<main id="main-content" tabindex="-1" class="stack">
  {{ content | safe }}
</main>

{% include "footer.njk" %}
<script type="module" src="/assets/interactions.js"></script>
</body>
</html>