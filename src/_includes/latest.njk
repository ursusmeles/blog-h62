{% from "blocks/post-card.njk" import card %}

<section class="container">
<div class="post-grid">
    <div class="post-grid__header">
        <h2>Najnowsze na blogu</h2>
        <p class="text-aside">Czytaj ostatnie teksty lub przeglądaj kategorie:</p>
        <ul role="list" class="cluster">
        {% for category in collections.categoryList %}
        <li><a href="/kategoria/{{ category | slugify }}/" class="category-tag">{{ category }}</a></li>
        {% endfor %}
        </ul>
        <a href="/teksty/" class="button" button-variant="typographic">Zobacz wszystko</a>
    </div>
{% set postslist = collections.posts | reverse %}
{% for post in postslist.slice(0, 7) %}

{{ card(post) }}

  {% endfor %}
</div>
</section>